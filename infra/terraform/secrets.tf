# Lab passwords.
#
# The password is generated by an *ephemeral* resource and written to Secret
# Manager through a *write-only* argument (secret_data_wo). Neither is ever
# saved in the Terraform plan or state file, so leaking the state does not
# leak the password. The VMs read it from Secret Manager at boot, and you read
# it with `gcloud secrets versions access` (see docs/lab_runbook.md).
#
# The trade-off: Terraform cannot know if the value changes, so rotating it means
# bumping secret_data_wo_version, which writes a new secret version.

locals {
  # domain_admin: the domain Administrator account (also the DC's local admin
  #               before promotion) and the account ws01 uses to join the domain.
  # dsrm:         Directory Services Restore Mode password, required by AD promotion.
  lab_secrets = toset(["domain_admin", "dsrm"])
}

ephemeral "random_password" "lab" {
  for_each = local.lab_secrets

  length      = 24
  min_upper   = 2
  min_lower   = 2
  min_numeric = 2
  min_special = 2
  # Characters that are safe inside PowerShell strings and RDP clients.
  override_special = "!#%*-_=+"
}

resource "google_secret_manager_secret" "lab" {
  for_each = local.lab_secrets

  secret_id = "purple-loop-${replace(each.key, "_", "-")}"

  replication {
    auto {}
  }

  depends_on = [google_project_service.apis]
}

resource "google_secret_manager_secret_version" "lab" {
  for_each = local.lab_secrets

  secret                 = google_secret_manager_secret.lab[each.key].id
  secret_data_wo         = ephemeral.random_password.lab[each.key].result
  secret_data_wo_version = 1
}

# Only the lab VMs' service account may read the secrets (plus project owners).
resource "google_secret_manager_secret_iam_member" "vm_reads_secret" {
  for_each = local.lab_secrets

  secret_id = google_secret_manager_secret.lab[each.key].id
  role      = "roles/secretmanager.secretAccessor"
  member    = google_service_account.lab_vm.member
}
