// Generated by scripts/convert_rules.py from rules/sigma/persistence/gcp_iam_service_account_key_created.yml. Do not edit by hand.
rule gcp_service_account_key_created {
  meta:
    id = "817c4af3-56eb-4c67-a120-0352491fd66d"
    title = "GCP Service Account Key Created"
    description = "Detects creation or upload of a user-managed key for a Google Cloud service account. A key is a long-lived credential that works from anywhere, outside the identity controls that protect people (MFA, session length). Attackers who gain IAM access create one to keep access after their original foothold is removed. Google recommends avoiding keys entirely (workload identity, impersonation), so in most environments every new key deserves a look."
    author = "Aryan Dhuru"
    reference = "https://attack.mitre.org/techniques/T1098/001/, https://cloud.google.com/iam/docs/best-practices-for-managing-service-account-keys"
    date = "2026-10-20"
    tags = "attack.persistence, attack.privilege-escalation, attack.t1098.001"
    severity = "medium"
    falsepositives = "Legacy integrations that still require a key file; filter their exact service account after review., Infrastructure-as-code that manages keys (e.g. Terraform google_service_account_key)."

  events:
    $event1.metadata.log_type = "GCP_CLOUDAUDIT" nocase AND $event1.metadata.product_event_type = /google.iam.admin.v1.CreateServiceAccountKey|google.iam.admin.v1.UploadServiceAccountKey/ nocase

  conditions:
    $event1
}
