// Generated by scripts/convert_rules.py from rules/sigma/persistence/proc_creation_win_schtasks_create_suspicious_action.yml. Do not edit by hand.
// DO NOT DEPLOY: AND/OR precedence differs from the Sigma rule.
rule scheduled_task_created_with_suspicious_action_via_schtasks {
  meta:
    id = "b2d24ff8-4275-49d6-85d0-18f46418cb73"
    title = "Scheduled Task Created With Suspicious Action Via Schtasks"
    description = "Detects schtasks.exe creating a task whose action (/TR) launches a script interpreter or LOLBin, decodes Base64, or runs from a user-writable folder. Attackers use scheduled tasks for persistence and for running payloads as SYSTEM. Legitimate tasks are mostly created by installers or Group Policy and point at signed binaries under Program Files or System32. This is the command-line half of a pair; the Security-log half (event 4698) catches tasks created through the API or PowerShell cmdlets, which never start schtasks.exe."
    author = "Aryan Dhuru"
    reference = "https://attack.mitre.org/techniques/T1053/005/, https://learn.microsoft.com/en-us/windows-server/administration/windows-commands/schtasks-create"
    date = "2026-10-14"
    tags = "attack.persistence, attack.execution, attack.privilege-escalation, attack.t1053.005"
    severity = "medium"
    falsepositives = "Administrators scheduling PowerShell maintenance scripts. Prefer filtering on the exact task name and script path rather than removing 'powershell' from the rule."

  events:
    $event1.metadata.event_type = "PROCESS_LAUNCH"
    ($event1.target.process.file.full_path = /\\schtasks\.exe$/ nocase OR $event1.target.process.file.names = "schtasks.exe" nocase) AND $event1.target.process.command_line = / -create / nocase OR $event1.target.process.command_line = / \/create / nocase OR $event1.target.process.command_line = / –create / nocase OR $event1.target.process.command_line = / —create / nocase OR $event1.target.process.command_line = / ―create / nocase AND $event1.target.process.command_line = /powershell|pwsh|mshta|rundll32|regsvr32|wscript|cscript|FromBase64String|\\AppData\\|\\Users\\Public\\|\\Windows\\Temp\\/ nocase

  conditions:
    $event1
}
