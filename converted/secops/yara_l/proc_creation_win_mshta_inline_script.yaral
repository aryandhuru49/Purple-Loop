// Generated by scripts/convert_rules.py from rules/sigma/stealth/proc_creation_win_mshta_inline_script.yml. Do not edit by hand.
rule mshta_executing_inline_script_or_remote_content {
  meta:
    id = "cc662858-29ab-43f9-9e40-366a02296e79"
    title = "Mshta Executing Inline Script Or Remote Content"
    description = "Detects mshta.exe running script directly from its command line (vbscript: or javascript: protocol handlers) or fetching content from a URL. mshta.exe is a Microsoft-signed binary that executes HTML Applications, so attackers use it to run script while appearing as a trusted process (signed binary proxy execution). Legitimate use, when it exists at all, opens a local .hta file from an installer or Program Files."
    author = "Aryan Dhuru"
    reference = "https://attack.mitre.org/techniques/T1218/005/, https://lolbas-project.github.io/lolbas/Binaries/Mshta/"
    date = "2026-10-14"
    tags = "attack.stealth, attack.t1218.005"
    severity = "high"
    falsepositives = "Legacy line-of-business HTA applications served from an internal web server; filter their exact URL."

  events:
    $event1.metadata.event_type = "PROCESS_LAUNCH"
    ($event1.target.process.file.full_path = /\\mshta\.exe$/ nocase OR $event1.target.process.file.names = "MSHTA.EXE" nocase) AND $event1.target.process.command_line = /vbscript:|javascript:|http:\/\/|https:\/\// nocase

  conditions:
    $event1
}
