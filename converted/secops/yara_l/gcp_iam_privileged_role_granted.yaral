// Generated by scripts/convert_rules.py from rules/sigma/persistence/gcp_iam_privileged_role_granted.yml. Do not edit by hand.
// DO NOT DEPLOY: the backend dropped a NOT; logic is inverted.
rule gcp_owner_or_editor_role_granted {
  meta:
    id = "873f0070-b76e-431e-88ab-510238a1d524"
    title = "GCP Owner or Editor Role Granted"
    description = "Detects an IAM policy change that ADDS the basic Owner or Editor role to any member. These roles give near-total control of a project, so granting them is a classic way to escalate privilege or keep access. The rule reads the policy delta (serviceData.policyDelta.bindingDeltas), not the request: SetIamPolicy logs the whole policy, and almost every project's policy already contains Editor (the default compute service account), so matching the request would fire on every IAM change. Removals are ignored."
    author = "Aryan Dhuru"
    reference = "https://attack.mitre.org/techniques/T1098/003/, https://cloud.google.com/iam/docs/roles-overview#basic"
    date = "2026-10-20"
    tags = "attack.persistence, attack.privilege-escalation, attack.t1098.003"
    severity = "high"
    falsepositives = "Administrators bootstrapping a new project; basic roles should still be rare after that., One change that both removes Owner and adds another role can match, because array fields are flattened (see normalize.flatten_log_entry)."

  events:
    $event1.metadata.log_type = "GCP_CLOUDAUDIT" nocase AND $event1.metadata.product_event_type = "SetIamPolicy" nocase AND $event1.principal.user.attribute.roles.description = /ADD/ nocase AND $event1.principal.user.attribute.roles.name = /roles\/owner|roles\/editor/ nocase AND $event1.principal.user.email_addresses = "service-agent-manager@system.gserviceaccount.com" nocase AND $event1.target.user.userid = /-compute@developer\.gserviceaccount\.com/ nocase

  conditions:
    $event1
}
