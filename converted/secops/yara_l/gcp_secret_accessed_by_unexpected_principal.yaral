// Generated by scripts/convert_rules.py from rules/sigma/credential_access/gcp_secret_accessed_by_unexpected_principal.yml. Do not edit by hand.
// DO NOT DEPLOY: the backend dropped a NOT; logic is inverted.
rule gcp_lab_secret_read_by_unexpected_principal {
  meta:
    id = "41e09c16-a504-49ab-9e37-c1c2b7a314ac"
    title = "GCP Lab Secret Read by Unexpected Principal"
    description = "Detects the value of a Purple Loop lab secret (domain admin and DSRM passwords) being read by anyone other than the lab VMs' own service account. Only the VMs need these values, at boot, so a read by a person or any other identity is either an admin break-glass action or credential theft. This is an environment-specific allow-list rule: adapt the secret name prefix and the expected workload identity to your own secrets. Requires Data Access audit logs for Secret Manager (infra/terraform/audit.tf)."
    author = "Aryan Dhuru"
    reference = "https://attack.mitre.org/techniques/T1555/006/, https://cloud.google.com/secret-manager/docs/audit-logging"
    date = "2026-10-20"
    tags = "attack.credential-access, attack.t1555.006"
    severity = "medium"
    falsepositives = "An administrator retrieving the domain admin password to RDP into the lab (expected, but should be rare)."

  events:
    $event1.metadata.log_type = "GCP_CLOUDAUDIT" nocase AND $event1.metadata.product_event_type = "google.cloud.secretmanager.v1.SecretManagerService.AccessSecretVersion" nocase AND $event1.target.resource.name = /\/secrets\/purple-loop-/ nocase AND $event1.principal.user.email_addresses = /^purple-loop-vm@/ nocase AND $event1.principal.user.email_addresses = /\.iam\.gserviceaccount\.com$/ nocase

  conditions:
    $event1
}
