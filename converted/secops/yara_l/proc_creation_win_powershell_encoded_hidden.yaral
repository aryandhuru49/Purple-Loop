// Generated by scripts/convert_rules.py from rules/sigma/execution/proc_creation_win_powershell_encoded_hidden.yml. Do not edit by hand.
rule hidden_powershell_window_with_encoded_command {
  meta:
    id = "b8bbb341-6e58-4e22-b662-7e497c7be4ba"
    title = "Hidden PowerShell Window With Encoded Command"
    description = "Detects PowerShell started with both a hidden window and a Base64-encoded command, the combination used by Empire, Cobalt Strike and many droppers ('powershell -noP -sta -w 1 -enc <base64>'). Each flag alone has legitimate uses (management tools hide windows, some installers encode commands), so requiring both keeps noise low. The windash modifier also matches the same flags written with '/' or other dash characters. The rule matches the binary by OriginalFileName too, so a renamed powershell.exe is caught."
    author = "Aryan Dhuru"
    reference = "https://attack.mitre.org/techniques/T1059/001/, https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.core/about/about_powershell_exe"
    date = "2026-10-14"
    tags = "attack.execution, attack.t1059.001, attack.stealth, attack.t1027"
    severity = "high"
    falsepositives = "Some RMM and software deployment agents launch hidden encoded commands. Review the parent process and filter known management tooling by its parent image path."

  events:
    $event1.metadata.event_type = "PROCESS_LAUNCH"
    ($event1.target.process.file.full_path = /\\powershell\.exe|\\pwsh\.exe/ nocase OR $event1.target.process.file.names = /PowerShell.EXE|pwsh.dll/ nocase) AND ($event1.target.process.command_line = / -e / nocase OR $event1.target.process.command_line = / \/e / nocase OR $event1.target.process.command_line = / –e / nocase OR $event1.target.process.command_line = / —e / nocase OR $event1.target.process.command_line = / ―e / nocase OR $event1.target.process.command_line = / -en / nocase OR $event1.target.process.command_line = / \/en / nocase OR $event1.target.process.command_line = / –en / nocase OR $event1.target.process.command_line = / —en / nocase OR $event1.target.process.command_line = / ―en / nocase OR $event1.target.process.command_line = / -enc / nocase OR $event1.target.process.command_line = / \/enc / nocase OR $event1.target.process.command_line = / –enc / nocase OR $event1.target.process.command_line = / —enc / nocase OR $event1.target.process.command_line = / ―enc / nocase OR $event1.target.process.command_line = / -enco/ nocase OR $event1.target.process.command_line = / \/enco/ nocase OR $event1.target.process.command_line = / –enco/ nocase OR $event1.target.process.command_line = / —enco/ nocase OR $event1.target.process.command_line = / ―enco/ nocase OR $event1.target.process.command_line = / -ec / nocase OR $event1.target.process.command_line = / \/ec / nocase OR $event1.target.process.command_line = / –ec / nocase OR $event1.target.process.command_line = / —ec / nocase OR $event1.target.process.command_line = / ―ec / nocase) AND ($event1.target.process.command_line = / -w 1 / nocase OR $event1.target.process.command_line = / \/w 1 / nocase OR $event1.target.process.command_line = / –w 1 / nocase OR $event1.target.process.command_line = / —w 1 / nocase OR $event1.target.process.command_line = / ―w 1 / nocase OR $event1.target.process.command_line = / -w h/ nocase OR $event1.target.process.command_line = / \/w h/ nocase OR $event1.target.process.command_line = / –w h/ nocase OR $event1.target.process.command_line = / —w h/ nocase OR $event1.target.process.command_line = / ―w h/ nocase OR $event1.target.process.command_line = / -win h/ nocase OR $event1.target.process.command_line = / \/win h/ nocase OR $event1.target.process.command_line = / –win h/ nocase OR $event1.target.process.command_line = / —win h/ nocase OR $event1.target.process.command_line = / ―win h/ nocase OR $event1.target.process.command_line = / -window h/ nocase OR $event1.target.process.command_line = / \/window h/ nocase OR $event1.target.process.command_line = / –window h/ nocase OR $event1.target.process.command_line = / —window h/ nocase OR $event1.target.process.command_line = / ―window h/ nocase OR $event1.target.process.command_line = / -windowstyle h/ nocase OR $event1.target.process.command_line = / \/windowstyle h/ nocase OR $event1.target.process.command_line = / –windowstyle h/ nocase OR $event1.target.process.command_line = / —windowstyle h/ nocase OR $event1.target.process.command_line = / ―windowstyle h/ nocase)

  conditions:
    $event1
}
