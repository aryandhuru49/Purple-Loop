// Generated by scripts/convert_rules.py from rules/sigma/credential_access/proc_creation_win_rundll32_comsvcs_minidump.yml. Do not edit by hand.
rule process_memory_dump_via_comsvcs_dll_minidump {
  meta:
    id = "8c770f3a-2ca1-4595-ae74-785f10192333"
    title = "Process Memory Dump Via Comsvcs.dll MiniDump"
    description = "Detects the 'living off the land' LSASS dumping technique that calls the MiniDump export of the built-in comsvcs.dll, usually as 'rundll32.exe C:\Windows\System32\comsvcs.dll MiniDump <lsass PID> <out file> full'. No attacker tool needs to touch disk, which makes it popular with ransomware operators. The export can also be called by its ordinal (#24), so the rule matches both forms and does not require the image to be rundll32.exe, which catches renamed copies too."
    author = "Aryan Dhuru"
    reference = "https://attack.mitre.org/techniques/T1003/001/, https://lolbas-project.github.io/lolbas/Libraries/comsvcs/"
    date = "2026-10-14"
    tags = "attack.credential-access, attack.t1003.001, attack.stealth, attack.t1218.011"
    severity = "high"
    falsepositives = "Very unlikely. Legitimate software has no reason to call comsvcs.dll MiniDump from a command line."

  events:
    $event1.metadata.event_type = "PROCESS_LAUNCH"
    $event1.target.process.command_line = /comsvcs/ nocase AND $event1.target.process.command_line = /MiniDump|#24|#\+24|#-4294967272/ nocase

  conditions:
    $event1
}
